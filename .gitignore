*.pem
*.key
*.p12
*.pfx
/auth.json
Homestead.json
Homestead.yaml
*.zip

# CRM Google Service Account Secrets
/storage/app/*.json
/storage/app/crm/*.json
/storage/*.json
*service-account*.json
*google-service-account*.json
*credential*.json

